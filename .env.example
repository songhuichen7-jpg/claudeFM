# LLM backend
# Leave unset to use Claude CLI when available.
# Set LLM_PROVIDER=deepseek to force DeepSeek, or use openai-compatible for
# another provider that implements POST /chat/completions.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Generic OpenAI-compatible alternative:
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
# OPENAI_COMPAT_MODEL=

# Optional tuning:
# LLM_TIMEOUT_MS=60000
# LLM_DJ_MAX_TOKENS=1400
# LLM_TASTE_MAX_TOKENS=12000
# LLM_TASTE_REBUILD_MAX_TOKENS=16000

# MiMo TTS
# MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-tts
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_VOICE=冰糖
