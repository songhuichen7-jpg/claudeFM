# Copy to .env and fill in your own keys. .env is git-ignored.

# ---- MiMo TTS (preferred) ------------------------------------------------
# Get a key at https://platform.xiaomimimo.com/
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-tts
# Preset voices: 冰糖/茉莉 (zh female), 苏打/白桦 (zh male),
#                Mia/Chloe (en female), Milo/Dean (en male)
MIMO_VOICE=冰糖
# Optional: override the e-girl director prompt baked into tts.ts
# MIMO_STYLE=

# ---- Fish Audio (fallback) ------------------------------------------------
# https://fish.audio
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s1
FISH_TEMP=0.8
FISH_TOP_P=0.8
FISH_CHUNK_LEN=120
FISH_SPEED=0.93
